# Required: LINE Developers > Messaging API channel
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Recommended: reuse the same RoleWeaver config used by the local web UI.
ROLEWEAVER_CONFIG_FILE=line\roleweaver.line.config.csv

# LINE bot server bind address. Use a public HTTPS tunnel to expose this port.
ROLEWEAVER_LINE_HOST=0.0.0.0
ROLEWEAVER_LINE_PORT=8010

# Per-LINE-user memory root. Leave empty to use data/line_sessions.
ROLEWEAVER_SESSION_ROOT=

# Optional: if the model raises an exception, show details in LINE replies.
ROLEWEAVER_LINE_DEBUG_ERRORS=0

# Optional: idle memory consolidation. 0 disables it.
ROLEWEAVER_IDLE_CONSOLIDATION_SECONDS=600

# Optional: daily wake-up push. Send /wake on in LINE to subscribe a user.
ROLEWEAVER_WAKEUP_ENABLED=0
ROLEWEAVER_WAKEUP_TIME=07:00
ROLEWEAVER_WAKEUP_TIMEZONE=Asia/Tokyo
ROLEWEAVER_WAKEUP_AUTO_SUBSCRIBE=0
ROLEWEAVER_WAKEUP_VOICE=0
ROLEWEAVER_REPLY_VOICE=0
ROLEWEAVER_WAKEUP_PROMPT=现在是早上7点。请作为秦谷美鈴，用日语轻轻叫醒制作人。短一点，像真人发来的早安，不要解释。
ROLEWEAVER_WAKEUP_FALLBACK_TEXT=あら……プロデューサー。朝ですよ。少しだけ目を開けてください。私、ここにいますから。

# Required only when ROLEWEAVER_WAKEUP_VOICE=1.
# This should be your current Cloudflare/ngrok public URL, without /callback.
ROLEWEAVER_PUBLIC_BASE_URL=
ROLEWEAVER_TTS_URL=http://127.0.0.1:9880/
ROLEWEAVER_TTS_REFER_WAV_PATH=
ROLEWEAVER_TTS_PROMPT_TEXT=
ROLEWEAVER_TTS_PROMPT_LANGUAGE=ja
ROLEWEAVER_TTS_TEXT_LANGUAGE=ja
ROLEWEAVER_TTS_TIMEOUT_SECONDS=180
ROLEWEAVER_TTS_FFMPEG_PATH=C:\Users\kator\Desktop\RoleWeaver\G\runtime\ffmpeg.exe
ROLEWEAVER_LINE_AUDIO_OUTPUT_DIR=C:\Users\kator\Desktop\RoleWeaver\data\line_audio
